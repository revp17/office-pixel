# Copia este archivo a .env.local y rellénalo para guardar en Nhost en vez de en la base de datos local (SQLite).
# Sin estas dos variables, la aplicación usa la base de datos local (npm run dev / npm start).
# En Vercel se ponen en Settings → Environment Variables, ANTES de compilar (Vite las incrusta al construir).

# Subdominio y región de tu proyecto de Nhost (panel de Nhost → Settings → General)
VITE_NHOST_SUBDOMAIN=
VITE_NHOST_REGION=

# Opcional: direcciones completas (Nhost local con la CLI o un dominio propio)
# VITE_NHOST_AUTH_URL=http://localhost:1337/v1
# VITE_NHOST_GRAPHQL_URL=http://localhost:1337/v1/graphql
